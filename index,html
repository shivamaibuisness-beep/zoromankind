      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
      margin-top: 3rem;
      padding: 1.5rem 2rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      backdrop-filter: blur(12px);
    }
    .review-stat {
      text-align: center;
    }
    .review-stat .num {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.6rem;
      color: var(--gold);
      font-weight: 700;
    }
    .review-stat .label {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* ===== CTA Banner ===== */
    .cta-banner {
      background: linear-gradient(135deg, rgba(245,197,24,0.12), rgba(0,230,118,0.08));
      border: 1px solid var(--border);
      border-radius: 24px;
      padding: 3.5rem 2rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .cta-banner::before {
      content: '';
      position: absolute;
      width: 300px; height: 300px;
      background: radial-gradient(circle, rgba(245,197,24,0.2), transparent 70%);
      top: -100px; right: -80px;

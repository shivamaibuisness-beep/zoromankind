    /* ===== Features ===== */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.5rem;
    }
    .feature-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 2rem 1.75rem;
      backdrop-filter: blur(12px);
      transition: all 0.35s;
      position: relative;
      overflow: hidden;
